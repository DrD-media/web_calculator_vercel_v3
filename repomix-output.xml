}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 8px;
}

.metric-cell {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: var(--radius-sm);
  padding: 6px 10px;
}

.metric-cell .m-label {
  display: block;
  font-size: 10.5px;
  color: var(--text-muted);
}

.metric-cell .m-val {
  font-size: 13.5px;
  font-weight: 700;
  color: #0f172a;
}

.conclusion-text {
  font-size: 12px;
  color: #1e293b;
  padding-top: 4px;
  border-top: 1px dashed #cbd5e1;
}

.nav-control-row {
  display: flex;
  gap: 6px;
}

/* --------------------------------------------------------------------------
   РАДАР ДИАГРАММА НАСТРОЙКИ
   -------------------------------------------------------------------------- */
.radar-time-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
}

.radar-time-group label {
  display: flex;
  align-items: center;
  gap: 6px;
