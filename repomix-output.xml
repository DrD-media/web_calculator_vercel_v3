  <!-- Chart.js local bundle with CDN fallback -->
  <script src="chart.umd.min.js"></script>
  <script>
    if (typeof Chart === 'undefined') {
      const cdnScript = document.createElement('script');
      cdnScript.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js';
      document.head.appendChild(cdnScript);
    }
  </script>
</head>
<body>
  <div class="app-container">
    <div id="runtimeErrorBanner" style="display:none; background:#fef2f2; color:#b91c1c; border:2px solid #ef4444; padding:16px; margin:16px; border-radius:8px; font-family:monospace; white-space:pre-wrap; z-index:9999;"></div>
    <!-- Шапка приложения -->
    <header class="app-header">
      <div class="header-content">
        <h1>Калькулятор системной динамики: Оценка качества ПО по ISO 9126 / 25010</h1>
        <p class="subtitle">Моделирование поддерева U₅ «Сопровождаемость» (28 характеристик, 187 функций связи, 6 внешних возмущений)</p>
      </div>
      <div class="header-status">
        <span class="status-badge" id="simStatusBadge">Модель готова к расчету</span>
      </div>
    </header>

    <!-- Навигация по вкладкам -->
    <nav class="app-tabs">
      <button class="tab-btn active" data-tab="tab-params">1. Параметры и начальные условия</button>
      <button class="tab-btn" data-tab="tab-pert">2. График возмущений (λ₁..λ₆)</button>
      <button class="tab-btn" data-tab="tab-dynamics">3. Динамика характеристик системы</button>
      <button class="tab-btn" data-tab="tab-radar">4. Лепестковая диаграмма</button>
      <button class="tab-btn" data-tab="tab-export">5. Таблица соответствия и экспорт</button>
    </nav>

    <!-- Содержимое вкладок -->
    <main class="tab-content-container">

      <!-- ВКЛАДКА 1: Параметры и начальные условия -->
      <section id="tab-params" class="tab-pane active">
        <div class="grid-2col">
          <!-- Левая колонка: Начальные условия u_i(0) и нормативные пределы u_lim -->
          <div class="card">
            <div class="card-header">
              <h2>Начальные условия uᵢ(0) и пределы допуска uᵢ,lim</h2>
              <div class="card-actions">
                <button class="btn btn-sm btn-secondary" id="btnRandU0">Случайные uᵢ(0)</button>
                <button class="btn btn-sm btn-secondary" id="btnResetU0">Сброс uᵢ(0)</button>
                <button class="btn btn-sm btn-secondary" id="btnHalfU0">0.50 для всех</button>
              </div>
            </div>
            <p class="section-desc">Характеристики приведены к строгому последовательному ряду u₁..u₂₈ с контролем дифференцированных нормативных пределов.</p>
            
            <!-- Панель пакетного задания пределов -->
            <div class="limits-batch-bar">
              <span class="limits-bar-title">Нормативные пределы (допуски):</span>
              <div class="limits-inputs-wrap">
                <label>Качество (u₁..u₆) ≥ <input type="number" id="batchLimitQuality" min="0" max="1" step="0.05" value="0.75" class="limit-input-num"></label>
                <label>Дефекты (u₇..u₂₈) ≤ <input type="number" id="batchLimitDefects" min="0" max="1" step="0.05" value="0.25" class="limit-input-num"></label>
                <button class="btn btn-xs btn-primary" id="btnApplyBatchLimits">Задать пределы для всех</button>
                <button class="btn btn-xs btn-secondary" id="btnPresetStep25">Шаг 0.25 (0.75 / 0.25)</button>
                <button class="btn btn-xs btn-outline" id="btnResetIndividualLimits" title="Установить индивидуальные отраслевые нормы стандарта ISO 9126 / 25010">Нормы ISO</button>
                <button class="btn btn-xs btn-secondary" id="btnRandLimits" title="Случайные дифференцированные пределы">Случайные пределы</button>
              </div>
            </div>

            <div class="table-container u0-table-scroll">
              <table class="data-table" id="tableU0">
                <thead>
                  <tr>
                    <th>Индекс</th>
                    <th>ISO</th>
                    <th>Характеристика качества</th>
                    <th>Требование допуска</th>
                    <th>uᵢ(0)</th>
                    <th>Предел uᵢ,lim</th>
                  </tr>
                </thead>
                <tbody id="tbodyU0">
                  <!-- Заполняется динамически JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Правая колонка: Уравнения функций связи F_k(x) и блок Управление -->
          <div class="card">
            <div class="card-header">
              <h2>Уравнения функций связи Fₖ(x) [всего 187]</h2>
              <div class="card-actions">
                <button class="btn btn-sm btn-primary" id="btnRandFuncs">Случайные коэффициенты</button>
                <button class="btn btn-sm btn-secondary" id="btnResetFuncs">Сброс к исходным</button>
              </div>
            </div>
            <p class="section-desc">
              Все 187 уравнений полиномиальных функций взаимодействия в классической математической форме F(x). Коэффициенты доступны для прямого ввода в строках.
            </p>

            <!-- Панель быстрых пресетов и поиска -->
            <div class="eq-top-toolbar">
              <div class="eq-quick-btns">
                <button class="btn btn-xs btn-secondary" id="btnSetAllDeg1">Все лин. (степень 1)</button>
                <button class="btn btn-xs btn-secondary" id="btnSetAllDeg2">Все кв. (степень 2)</button>
                <button class="btn btn-xs btn-secondary" id="btnSetAllDeg3">Все куб. (степень 3)</button>
              </div>
              <div class="eq-search-box">
                <label for="searchEqInput">Поиск:</label>
                <input type="text" id="searchEqInput" placeholder="Номер F или u..." class="form-input" style="width: 120px; padding: 2px 6px; font-size: 11px;">
                <label for="quickJumpFunc">Перейти:</label>
                <select id="quickJumpFunc" class="form-select" style="width: 80px; padding: 2px 4px; font-size: 11px;"></select>
              </div>
            </div>

            <!-- Список всех 187 уравнений со скроллом -->
            <div class="equations-scroll-container" id="equationsList">
              <!-- Заполняется динамически JS всеми 187 строками -->
            </div>

            <!-- Блок Управление (соответствует стилю примера преподавателя) -->
            <div class="management-card">
              <div class="mgmt-header">Управление</div>
