  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid var(--accent);
}

.header-content h1 {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.header-content .subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.status-badge {
  background-color: #1e293b;
  color: #38bdf8;
  border: 1px solid #334155;
  padding: 6px 12px;
  border-radius: var(--radius-md);
  font-size: 12px;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   ВКЛАДКИ НАВИГАЦИИ
