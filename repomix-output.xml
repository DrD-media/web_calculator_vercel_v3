  justify-content: space-between;
  border-top: 1px solid #334155;
  margin-top: auto;
}

@media (max-width: 768px) {
  .app-footer {
    flex-direction: column;
    gap: 4px;
  }
}

/* --------------------------------------------------------------------------
   ПРЕДЕЛЬНЫЕ ЗНАЧЕНИЯ И НОРМЫ
   -------------------------------------------------------------------------- */
.limits-batch-bar {
  background-color: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  margin-bottom: 12px;
}

.limits-bar-title {
  display: block;
  font-size: 12.5px;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 6px;
}

.limits-inputs-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  font-size: 12px;
}

.limit-input-num {
  width: 65px;
  padding: 3px 6px;
  border: 1px solid #94a3b8;
  border-radius: 4px;
  font-weight: 600;
  text-align: right;
  background-color: #ffffff;
}

.ulim-input {
  width: 72px;
  padding: 3px 6px;
  border: 1px solid #f87171;
  background-color: #fff5f5;
  border-radius: var(--radius-sm);
  font-size: 12px;
  text-align: right;
  font-weight: 700;
  color: #b91c1c;
}

.badge-qual {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  color: #166534;
  background-color: #dcfce7;
  padding: 2px 6px;
  border-radius: 4px;
}

.badge-def {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  color: #9a3412;
  background-color: #ffedd5;
  padding: 2px 6px;
  border-radius: 4px;
}

/* --------------------------------------------------------------------------
   СПИСОК УРАВНЕНИЙ СВЯЗИ F_k(x) (КЛАССИЧЕСКИЙ СТИЛЬ)
   -------------------------------------------------------------------------- */
.eq-top-toolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e2e8f0;
}

.eq-quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.eq-search-box {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
}

.equations-scroll-container {
  max-height: 480px;
  overflow-y: auto;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  background-color: #f8fafc;
  padding: 8px;
}

.eq-row {
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 4px;
  padding: 8px 12px;
  margin-bottom: 6px;
  transition: all 0.15s ease;
}

.eq-row:hover {
  background-color: #f1f5f9;
  border-color: #94a3b8;
}

.eq-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  font-size: 12px;
}

.eq-f-label {
  font-weight: 700;
  color: #1e3a8a;
  font-size: 13px;
}

.eq-arg-desc {
  font-size: 11.5px;
  color: #64748b;
  margin-left: 6px;
}

.eq-deg-select {
  font-size: 11.5px;
  padding: 2px 6px;
  border: 1px solid #cbd5e1;
  border-radius: 3px;
  background-color: #ffffff;
}

.eq-row-body {
  font-family: Consolas, "Courier New", monospace;
  font-size: 13px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  color: #0f172a;
}

.eq-row-body .eq-f-title {
  font-weight: bold;
  color: #2563eb;
  margin-right: 4px;
}

.eq-coeff-num {
  width: 58px;
  padding: 2px 4px;
  border: 1px solid #94a3b8;
  border-radius: 3px;
  font-family: inherit;
  font-size: 12.5px;
  text-align: right;
  font-weight: 600;
  background-color: #ffffff;
}

.eq-coeff-num:focus {
  outline: none;
  border-color: #2563eb;
  background-color: #eff6ff;
}

.eq-term-span {
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.eq-term-str {
  color: #475569;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   БЛОК УПРАВЛЕНИЯ (ПО СКРИНШОТУ ПРЕПОДАВАТЕЛЯ)
   -------------------------------------------------------------------------- */
.management-card {
  background-color: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: var(--radius-md);
  padding: 14px;
  margin-top: 14px;
}

.mgmt-header {
  font-size: 13px;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.mgmt-status-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.mgmt-buttons-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 8px;
}

@media (max-width: 900px) {
  .mgmt-buttons-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* --------------------------------------------------------------------------
   РАДАР ДИАГРАММА: ПРАВИЛА И КРАСНАЯ ЛИНИЯ ПРЕДЕЛА
   -------------------------------------------------------------------------- */
.radar-rules-banner {
  background-color: #f8fafc;
  border: 1px solid #cbd5e1;
  border-left: 4px solid #dc2626;
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  margin-bottom: 14px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-size: 12.5px;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #1e293b;
}

.compliance-status-card {
  margin-top: 16px;
  padding: 12px;
  background-color: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: var(--radius-sm);
  font-size: 12px;
}

.compliance-header {
  font-weight: 700;
  margin-bottom: 6px;
  color: #1e293b;
}

.compliance-tag-ok {
  color: #166534;
  font-weight: bold;
}

.compliance-tag-bad {
  color: #b91c1c;
  font-weight: bold;
}

/* --------------------------------------------------------------------------
   БЕЙДЖИ РУЧНОГО ВВОДА И ВЫДЕЛЕНИЕ СТРОКИ
   -------------------------------------------------------------------------- */
.badge-custom-func {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 600;
  color: #1d4ed8;
  background-color: #dbeafe;
  border: 1px solid #93c5fd;
  padding: 1px 7px;
  border-radius: 4px;
  letter-spacing: 0.2px;
}

.badge-custom-reset-btn {
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  padding: 0 2px;
  font-size: 11px;
  font-weight: bold;
  line-height: 1;
}

.badge-custom-reset-btn:hover {
  color: #b91c1c;
}

.eq-row.is-custom {
  border-left: 3px solid #2563eb;
  background-color: #f8fafc;
}

/* --------------------------------------------------------------------------
   МОДАЛЬНОЕ ОКНО ПОДТВЕРЖДЕНИЯ ДЕЙСТВИЯ (ДИАЛОГ ЗАПОЛНЕНИЯ)
   -------------------------------------------------------------------------- */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(2px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.modal-dialog {
  background-color: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.25), 0 8px 10px -6px rgb(0 0 0 / 0.25);
  width: 100%;
  max-width: 520px;
  overflow: hidden;
  border: 1px solid #cbd5e1;
  animation: modalScaleIn 0.18s ease-out;
}

@keyframes modalScaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-header {
  padding: 16px 20px;
  background-color: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-header h3 {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-close-btn {
  background: none;
  border: none;
  font-size: 20px;
  line-height: 1;
  color: #64748b;
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 4px;
}

.modal-close-btn:hover {
  background-color: #e2e8f0;
  color: #0f172a;
}

.modal-body {
  padding: 20px;
  font-size: 13px;
  color: #334155;
  line-height: 1.6;
}

.modal-body p {
  margin-bottom: 12px;
}

.modal-info-box {
  background-color: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  padding: 10px 14px;
  margin: 12px 0;
  font-size: 12.5px;
}

.modal-info-box strong {
  color: #1e40af;
}

.modal-actions {
  padding: 14px 20px;
  background-color: #f8fafc;
  border-top: 1px solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.modal-btn-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
  border: 1px solid transparent;
  text-align: left;
}

.modal-btn-option .sub {
  display: block;
  font-size: 11px;
  font-weight: 400;
  margin-top: 2px;
  opacity: 0.85;
}

.modal-btn-protect {
  background-color: #2563eb;
  color: #ffffff;
  border-color: #1d4ed8;
}

.modal-btn-protect:hover {
  background-color: #1d4ed8;
}

.modal-btn-overwrite {
  background-color: #ffffff;
  color: #b91c1c;
  border-color: #fca5a5;
}

.modal-btn-overwrite:hover {
  background-color: #fef2f2;
  border-color: #ef4444;
}

.modal-btn-cancel {
  background-color: #e2e8f0;
  color: #334155;
  border-color: #cbd5e1;
  justify-content: center;
}

.modal-btn-cancel:hover {
  background-color: #cbd5e1;
}

/* --------------------------------------------------------------------------
   ВСПЛЫВАЮЩИЕ УВЕДОМЛЕНИЯ (TOASTS)
   -------------------------------------------------------------------------- */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 10000;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  background-color: #0f172a;
  color: #f8fafc;
  padding: 10px 18px;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 500;
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.2);
  display: flex;
  align-items: center;
  gap: 10px;
  border-left: 4px solid var(--accent);
  animation: toastSlideIn 0.2s ease-out;
}

.toast.toast-success {
  border-left-color: #16a34a;
}

.toast.toast-info {
  border-left-color: #2563eb;
}

.toast.toast-warning {
  border-left-color: #eab308;
}

@keyframes toastSlideIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* --------------------------------------------------------------------------
   МОДАЛЬНОЕ ОКНО РЕЗУЛЬТАТОВ РАСЧЕТА МОДЕЛИ
   -------------------------------------------------------------------------- */
.modal-dialog-lg {
  max-width: 720px;
}

.res-kpi-card {
  background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
  border: 1px solid #cbd5e1;
  border-radius: var(--radius-md);
  padding: 16px;
  margin-bottom: 16px;
}

.res-kpi-header {
  font-size: 13.5px;
  font-weight: 700;
  color: #1e3a8a;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.res-metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}

.res-metric-cell {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  padding: 8px 12px;
  text-align: center;
}

.res-m-label {
  display: block;
  font-size: 11px;
  color: #64748b;
  margin-bottom: 2px;
}

.res-m-val {
  font-size: 15px;
  font-weight: 800;
  color: #0f172a;
}

.res-m-val.trend-up {
  color: #16a34a;
}

.res-m-val.trend-down {
  color: #dc2626;
}

.res-verdict-box {
  background: #ffffff;
  border-left: 4px solid #2563eb;
  padding: 8px 12px;
  border-radius: 4px;
  font-size: 12.5px;
  font-weight: 600;
  color: #1e293b;
}

.res-compliance-summary {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.res-comp-pill {
  flex: 1;
  min-width: 220px;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 12.5px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.res-comp-pill.quality {
  background-color: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1e40af;
}

.res-comp-pill.defects {
  background-color: #fef2f2;
  border: 1px solid #fecaca;
  color: #991b1b;
}

.res-table-wrap {
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 8px;
}

.res-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.res-table th {
  background-color: #f1f5f9;
  padding: 8px 10px;
  text-align: left;
  font-weight: 700;
  color: #475569;
  border-bottom: 1px solid #cbd5e1;
}

.res-table td {
  padding: 6px 10px;
  border-bottom: 1px solid #f1f5f9;
  color: #1e293b;
}

.res-table tr:last-child td {
  border-bottom: none;
}
