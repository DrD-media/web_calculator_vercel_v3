/**
 * Математическое ядро модели системной динамики:
 * Численное интегрирование методом Рунге-Кутта 4-го порядка системы 28 ОДУ (ISO 9126 / 25010)
 * с нелинейным гармоническим откликом на внешние возмущения lambda_1..lambda_6,
 * устойчивым балансом взаимодействия "качество - дефекты" (без схлопывания дефектов в ноль)
 * и прямой чувствительностью к коэффициентам полиномиальных функций связи F_k(x).
 */

class PolynomialFunction {
    constructor(id, arg_u, degree, a, b, c, d) {
        this.id = id;
        this.arg_u = arg_u;
        this.degree = degree;
        this.a = a;
        this.b = b;
        this.c = c;
        this.d = d;
    }

    evaluate(x) {
        const x_val = Math.max(0.05, Math.min(1.5, x));
        let val = 0.0;
        if (this.degree === 1) {
            val = this.c * x_val + this.d;
        } else if (this.degree === 2) {
            val = this.b * x_val * x_val + this.c * x_val + this.d;
        } else {
            val = this.a * x_val * x_val * x_val + this.b * x_val * x_val + this.c * x_val + this.d;
        }
        return Math.max(0.01, val);
    }
}

class SimulationModel {
    constructor() {
        this.functions = {};
        this.initDefaultFunctions();
    }

    initDefaultFunctions(skipIdsSet = null) {
        for (const item of DEFAULT_FUNCTIONS) {
            if (skipIdsSet && skipIdsSet.has(item.id)) {
                continue;
            }
            this.functions[item.id] = new PolynomialFunction(
                item.id, item.arg_u, item.degree, item.a, item.b, item.c, item.d
            );
        }
    }

    randomizeFunctions(skipIdsSet = null) {
        for (let f_id = 1; f_id <= 187; f_id++) {
            if (skipIdsSet && skipIdsSet.has(f_id)) {
                continue;
            }
            const func = this.functions[f_id];
            const rand = Math.random();
            let deg = 1;
            if (rand < 0.50) deg = 1;
            else if (rand < 0.85) deg = 2;
            else deg = 3;

            func.degree = deg;
            if (deg === 1) {
                func.a = 0.0;
                func.b = 0.0;
                func.c = Math.round((0.30 + Math.random() * 0.70) * 1000) / 1000;
                func.d = Math.round((0.10 + Math.random() * 0.40) * 1000) / 1000;
            } else if (deg === 2) {
                func.a = 0.0;
                func.b = Math.round((0.15 + Math.random() * 0.45) * 1000) / 1000;
                func.c = Math.round((0.25 + Math.random() * 0.55) * 1000) / 1000;
                func.d = Math.round((0.05 + Math.random() * 0.35) * 1000) / 1000;
            } else {
                func.a = Math.round((0.10 + Math.random() * 0.30) * 1000) / 1000;
                func.b = Math.round((0.15 + Math.random() * 0.40) * 1000) / 1000;
                func.c = Math.round((0.20 + Math.random() * 0.50) * 1000) / 1000;
                func.d = Math.round((0.05 + Math.random() * 0.30) * 1000) / 1000;
            }
        }
    }

    static evaluatePerturbations(t) {
        const pi = Math.PI;
        // 6 внешних возмущений системы (ISO 9126 / U5):
        // lambda1: Опыт разработчиков - монотонный рост [0.60, 1.00]
        const l1 = 0.4 * (t * t) + 0.6;
        // lambda2: Опыт эксплуатационного персонала - гармонические колебания cos^2 [0.20, 0.45]
        const cos_l2 = Math.cos(1.5 * pi * t - pi / 6.0);
        const l2 = 0.25 * (cos_l2 * cos_l2) + 0.20;
        // lambda3: Трудоемкость разработки - гармоническая синусоида [0.175, 0.700] с пиком в середине
        const l3 = 0.35 * Math.sin(pi * t - pi / 6.0) + 0.35;
        // lambda4: Курс валют (экономический фактор) - линейный рост [0.20, 1.00]
        const l4 = 0.80 * t + 0.20;
        // lambda5: Деловая репутация разработчиков - гармонические колебания sin^2 [0.20, 0.50]
        const sin_l5 = Math.sin(pi * t - pi / 6.0);
        const l5 = 0.30 * (sin_l5 * sin_l5) + 0.20;
        // lambda6: Деловая репутация заказчика - гармонические колебания cos^2 [0.40, 0.65] (минимум в середине)
        const cos_l6 = Math.cos(pi * t);
        const l6 = 0.25 * (cos_l6 * cos_l6) + 0.40;
        return [l1, l2, l3, l4, l5, l6];
    }

    computeDerivatives(t, u) {
        const lambdas = SimulationModel.evaluatePerturbations(t);
        const du_dt = new Array(28).fill(0.0);

        for (let eq_idx = 0; eq_idx < EQUATIONS.length; eq_idx++) {
            const eq = EQUATIONS[eq_idx];
            const target_idx = eq.target_u - 1;
            const u_target = u[target_idx];
            const isQuality = CHARACTERISTICS[target_idx].is_quality;

            // 1. Положительные связи (Phi^+)
            let pos_geom = 1.0;
            const pos_funcs = eq.pos.funcs;
            if (pos_funcs.length > 0) {
                let prod = 1.0;
                for (let k = 0; k < pos_funcs.length; k++) {
                    const [f_id, arg_u] = pos_funcs[k];
                    const val = this.functions[f_id].evaluate(u[arg_u - 1]);
                    prod *= (val / 0.35);
                }
                pos_geom = Math.pow(prod, 1.0 / pos_funcs.length);
            }

            let pos_lambda = 0.0;
            if (eq.pos.lambdas.length > 0) {
                for (let k = 0; k < eq.pos.lambdas.length; k++) {
                    pos_lambda += lambdas[eq.pos.lambdas[k] - 1];
                }
                pos_lambda /= eq.pos.lambdas.length;
            } else {
                // Для дефектов источником генерации служит интенсивность разработки (гармоника lambda3)
                pos_lambda = isQuality ? lambdas[0] : (lambdas[2] * 1.35 + 0.10);
            }

            // 2. Отрицательные связи (Phi^-)
            let neg_geom = 1.0;
            const neg_funcs = eq.neg.funcs;
            if (neg_funcs.length > 0) {
                let prod = 1.0;
                for (let k = 0; k < neg_funcs.length; k++) {
                    const [f_id, arg_u] = neg_funcs[k];
                    const val = this.functions[f_id].evaluate(u[arg_u - 1]);
                    prod *= (val / 0.35);
                }
                neg_geom = Math.pow(prod, 1.0 / neg_funcs.length);
            }

            let neg_lambda = 0.0;
            if (eq.neg.lambdas.length > 0) {
                for (let k = 0; k < eq.neg.lambdas.length; k++) {
                    neg_lambda += lambdas[eq.neg.lambdas[k] - 1];
                }
                neg_lambda /= eq.neg.lambdas.length;
            } else {
                // Для качества тормозящим фактором выступает пиковая трудоемкость lambda3
                neg_lambda = isQuality ? (lambdas[2] * 1.25) : lambdas[0];
            }

            const phi_pos = pos_geom * pos_lambda;
            const phi_neg = neg_geom * neg_lambda;

            let diff = 0.0;
            if (isQuality) {
                // Рост качества ускоряется опытом lambda1 (особенно в конце t > 0.6)
                // а в середине (t ~ 0.3..0.6) тормозится нагрузкой и дефектами
                const qualityForce = (phi_pos * (0.85 + 0.45 * lambdas[0]) - phi_neg * (0.90 + 0.50 * lambdas[2]));
                diff = 0.85 * qualityForce - 0.25 * (u_target - 0.74);
            } else {
                // Рост дефектов стимулируется пиком трудоемкости lambda3 (середина проекта)
                // устранение дефектов форсируется опытом lambda1 (t > 0.6)
                const defectGen = phi_pos * (1.30 + 0.90 * lambdas[2]);
                const defectFix = phi_neg * (0.70 + 0.90 * lambdas[0]);
                const defectForce = defectGen - defectFix;
                diff = 0.70 * defectForce - 0.45 * (u_target - 0.30);
            }

            // Мягкое ограничение диапазона [uMin, uMax]
            const uMin = isQuality ? 0.52 : 0.18;
            const uMax = isQuality ? 0.94 : 0.52;

            if (diff < 0) {
                const margin = Math.max(0.0, (u_target - uMin) / 0.12);
                diff *= Math.min(1.0, margin * margin);
            } else {
                const margin = Math.max(0.0, (uMax - u_target) / 0.12);
                diff *= Math.min(1.0, margin * margin);
            }

            du_dt[target_idx] = diff;
        }

        return du_dt;
    }

    solve(u0, numSteps = 100) {
        const dt = 1.0 / numSteps;
        const t = [];
        for (let s = 0; s <= numSteps; s++) {
            t.push(Math.round(s * dt * 1000) / 1000);
        }

        const uHistory = [];
        for (let i = 0; i < 28; i++) {
            uHistory.push(new Array(numSteps + 1).fill(0.0));
            uHistory[i][0] = Math.max(0.05, Math.min(1.0, u0[i]));
        }

        const lambdasHistory = [];
        for (let k = 0; k < 6; k++) {
            lambdasHistory.push(new Array(numSteps + 1).fill(0.0));
        }

        for (let step = 0; step < numSteps; step++) {
            const t_curr = t[step];
            const u_curr = new Array(28);
            for (let i = 0; i < 28; i++) {
                u_curr[i] = uHistory[i][step];
            }

            // Вычисляем возмущения
            const l_curr = SimulationModel.evaluatePerturbations(t_curr);
            for (let k = 0; k < 6; k++) {
                lambdasHistory[k][step] = l_curr[k];
            }

            // RK4
            const k1 = this.computeDerivatives(t_curr, u_curr);

            const u_k2 = new Array(28);
            for (let i = 0; i < 28; i++) u_k2[i] = u_curr[i] + 0.5 * dt * k1[i];
            const k2 = this.computeDerivatives(t_curr + 0.5 * dt, u_k2);

            const u_k3 = new Array(28);
            for (let i = 0; i < 28; i++) u_k3[i] = u_curr[i] + 0.5 * dt * k2[i];
            const k3 = this.computeDerivatives(t_curr + 0.5 * dt, u_k3);

            const u_k4 = new Array(28);
            for (let i = 0; i < 28; i++) u_k4[i] = u_curr[i] + dt * k3[i];
            const k4 = this.computeDerivatives(t_curr + dt, u_k4);

            for (let i = 0; i < 28; i++) {
                let u_next = u_curr[i] + (dt / 6.0) * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]);
                u_next = Math.max(0.05, Math.min(1.0, u_next));
                uHistory[i][step + 1] = u_next;
            }
        }

        // Конечное значение lambda
        const l_final = SimulationModel.evaluatePerturbations(1.0);
        for (let k = 0; k < 6; k++) {
            lambdasHistory[k][numSteps] = l_final[k];
        }

        // Поквартальные срезы
        const quarters = {
            t0: { t: 0.00, label: "t = 0.00 (Начало)", values: uHistory.map(row => row[0]) },
            t1: { t: 0.25, label: "t = 0.25 (1-я четв.)", values: uHistory.map(row => row[Math.round(numSteps * 0.25)]) },
            t2: { t: 0.50, label: "t = 0.50 (2-я четв.)", values: uHistory.map(row => row[Math.round(numSteps * 0.50)]) },
            t3: { t: 0.75, label: "t = 0.75 (3-я четв.)", values: uHistory.map(row => row[Math.round(numSteps * 0.75)]) },
            t4: { t: 1.00, label: "t = 1.00 (Финал)", values: uHistory.map(row => row[numSteps]) },
        };

        return {
            t: t,
            u: uHistory,
            lambdas: lambdasHistory,
            quarters: quarters
        };
    }
}
